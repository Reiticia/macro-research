# Market Event Analyzer systemd unit.
# This file is a template rendered by deploy.sh (@VAR@ placeholders are substituted).
# For a manual install, replace the placeholders yourself or just use deploy.sh.
[Unit]
Description=Market Event Analyzer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@APP_USER@
Group=@APP_GROUP@
WorkingDirectory=@APP_DIR@
Environment=RUST_LOG=market_event_analyzer=info,tower_http=info
# KEY=value 文件，保存 API_TOKENS / OPENAI_API_KEY / TELEGRAM_BOT_TOKEN /
# TELEGRAM_ADMIN_CHAT_IDS / TE_API_KEY 等密钥，权限 0640。
# 前缀 "-" 表示文件不存在时不报错。
EnvironmentFile=-@ENV_FILE@
ExecStart=@APP_DIR@/market-event-analyzer
Restart=always
RestartSec=5
# 进程内用 tokio ctrl_c 处理优雅退出，因此显式发送 SIGINT。
KillSignal=SIGINT
TimeoutStopSec=30

# 基础加固：不可提权、私有 /tmp、系统目录只读、隐藏 home。
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
